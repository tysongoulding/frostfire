--- a/deploy/aws/firecracker-hypervisor.yaml
+++ b/deploy/aws/firecracker-hypervisor.yaml
@@ -261,10 +261,39 @@ Resources:
-          # 4. Configure Networking & Bridge for MicroVM Tap Interfaces
+          # 4. Configure Isolated Networking for MicroVM Tap Interfaces
           mkdir -p /var/lib/frostfire /var/run/frostfire
           sysctl -w net.ipv4.ip_forward=1
           echo "net.ipv4.ip_forward = 1" >> /etc/sysctl.d/99-frostfire.conf
 
-          # Setup bridge and NAT rule
+          # Primary physical interface for host external communication
           PRIMARY_IFACE=$(ip -4 route show default | awk '{print $5}' | head -n1)
-          iptables -t nat -A POSTROUTING -o "${PRIMARY_IFACE}" -j MASQUERADE || true
+
+          # Configure point-to-point TAP interfaces for microVMs (172.16.x.0/24)
+          setup_tap() {
+            local TAP_NAME="$1"
+            local HOST_IP="$2"
+            if ! ip link show "${TAP_NAME}" > /dev/null 2>&1; then
+              ip tuntap add dev "${TAP_NAME}" mode tap user root
+              ip addr add "${HOST_IP}/24" dev "${TAP_NAME}"
+              ip link set dev "${TAP_NAME}" up
+            fi
+          }
+
+          setup_tap "tap0" "172.16.0.1"
+          setup_tap "tap1" "172.16.1.1"
+          setup_tap "tap2" "172.16.2.1"
+
+          # ENFORCE SECURITY INVARIANT: Strict microVM network isolation
+          # 1. Zero NAT MASQUERADE on WAN interface for microVM TAP traffic.
+          # 2. Explicitly DROP all forwarding from microVM guest subnets (172.16.0.0/16) to WAN.
+          iptables -A FORWARD -s 172.16.0.0/16 -o "${PRIMARY_IFACE}" -j DROP
+          iptables -A FORWARD -i "${PRIMARY_IFACE}" -d 172.16.0.0/16 -j DROP
+
+          # 3. Block microVM access to AWS Instance Metadata Service (IMDS)
+          iptables -A FORWARD -s 172.16.0.0/16 -d 169.254.169.254 -j DROP
+
+          # 4. Allow local host-guest point-to-point traffic (for reverse-tunnel gateway connection)
+          for TAP in tap0 tap1 tap2; do
+            iptables -A INPUT -i "${TAP}" -s 172.16.0.0/16 -j ACCEPT
+            iptables -A OUTPUT -o "${TAP}" -d 172.16.0.0/16 -j ACCEPT
+          done
 
