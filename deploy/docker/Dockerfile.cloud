# syntax=docker/dockerfile:1
FROM rust:1.80-slim-bullseye AS builder

WORKDIR /usr/src/frostfire

# Install build dependencies (protobuf, pkg-config, make, libssl-dev)
RUN apt-get update && apt-get install -y --no-install-recommends \
    protobuf-compiler \
    pkg-config \
    libssl-dev \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy workspace files
COPY Cargo.toml Cargo.lock .frostfire.toml ./
COPY crates/ crates/
COPY services/ services/
COPY cloud/ cloud/

# Compile release binaries for gateway and orchestrator
RUN cargo build --release -p frostfire-gateway -p frostfire-orchestrator

# Runtime container
FROM debian:bullseye-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libssl1.1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /usr/src/frostfire/target/release/frostfire-gateway /usr/local/bin/frostfire-gateway
COPY --from=builder /usr/src/frostfire/target/release/frostfire-orchestrator /usr/local/bin/frostfire-orchestrator

ENV RUST_LOG=info
EXPOSE 50051

ENTRYPOINT ["frostfire-gateway"]
CMD ["--bind", "0.0.0.0:50051"]
