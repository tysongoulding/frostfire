#!/usr/bin/env bash
set -euo pipefail

# Packs the WebAuthn proxy extension into a CRX at image build time and writes
# every artifact that has to agree on its ID. A CRX because managed Chrome
# silently ignores --load-extension; a force-install policy entry is the only
# way in. The signing key is generated per build, so the extension ID changes
# every build — safe only because every consumer of the ID is generated below
# from the same key. A new consumer must be templated here too.

EXT_SRC=/usr/local/share/sand-webauthn-proxy
CRX=/usr/local/share/sand-webauthn-proxy.crx
UPDATE_XML=/usr/local/share/sand-webauthn-proxy-update.xml
POLICY_DIR=/etc/opt/chrome/policies/managed
NATIVE_HOST_DIR=/etc/opt/chrome/native-messaging-hosts
KEY=/usr/local/share/sand-webauthn-proxy.pem

# Chrome's --pack-extension-key wants PKCS#8; `openssl genrsa` emits PKCS#1 and
# Chrome rejects it with a bare "Failed to read private key".
openssl genrsa 2048 2>/dev/null | openssl pkcs8 -topk8 -nocrypt -out "${KEY}"
chmod 600 "${KEY}"

# A `key` field in the manifest would override the signing key as the ID source.
python3 - "${EXT_SRC}/manifest.json" <<'PY'
import json, sys
path = sys.argv[1]
manifest = json.load(open(path))
manifest.pop("key", None)
json.dump(manifest, open(path, "w"), indent="\t")
PY

VERSION="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["version"])' "${EXT_SRC}/manifest.json")"

# Chrome writes the CRX beside the source dir as <dir>.crx == ${CRX}.
google-chrome-stable --no-sandbox --pack-extension="${EXT_SRC}" --pack-extension-key="${KEY}"
test -f "${CRX}"
chmod 644 "${CRX}"

# The ID is the first 16 bytes of the SHA-256 of the DER public key, with each
# hex nibble mapped 0-f -> a-p.
EXT_ID="$(openssl rsa -in "${KEY}" -pubout -outform DER 2>/dev/null | python3 -c '
import hashlib, sys
digest = hashlib.sha256(sys.stdin.buffer.read()).hexdigest()[:32]
print("".join(chr(ord("a") + int(c, 16)) for c in digest))
')"

mkdir -p "${POLICY_DIR}" "${NATIVE_HOST_DIR}"

cat >"${UPDATE_XML}" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<gupdate xmlns="http://www.google.com/update2/response" protocol="2.0">
  <app appid="${EXT_ID}">
    <updatecheck codebase="file://${CRX}" version="${VERSION}" />
  </app>
</gupdate>
EOF

cat >"${NATIVE_HOST_DIR}/co.anysphere.sand.webauthn_proxy.json" <<EOF
{
	"name": "co.anysphere.sand.webauthn_proxy",
	"description": "Sand WebAuthn proxy bridge — forwards box browser ceremonies to the in-box host.",
	"path": "/usr/local/bin/sand-webauthn-proxy-host",
	"type": "stdio",
	"allowed_origins": ["chrome-extension://${EXT_ID}/"]
}
EOF

# The force-install entry is written at browser launch by box-chrome-policy
# (opt-in), so it is pre-created box-writable here: /etc/opt/chrome is
# root-owned.
printf '{}\n' >"${POLICY_DIR}/sand-webauthn.json"
chown box:box "${POLICY_DIR}/sand-webauthn.json"
chmod 644 "${POLICY_DIR}/sand-webauthn.json"

# Consumed by box-chrome to write the policy entry.
printf '%s' "${EXT_ID}" >/usr/local/share/sand-webauthn-proxy.id

echo "packed sand-webauthn-proxy ${VERSION} as ${EXT_ID}"
