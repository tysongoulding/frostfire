#!/usr/bin/env bash
set -euo pipefail

# Chrome's native-messaging manifest `path` must be an executable, and the
# bridge is a .mjs; the box ships node at /exec-daemon/node.
#
# stdout is the native-messaging channel: a stray echo corrupts the frame and
# Chrome kills the host. Diagnostics go to stderr.
node_bin="${SAND_WEBAUTHN_PROXY_NODE:-/exec-daemon/node}"
if [ ! -x "${node_bin}" ]; then
	node_bin="$(command -v node || true)"
fi
if [ -z "${node_bin}" ] || [ ! -x "${node_bin}" ]; then
	echo "sand-webauthn-proxy-host: no node runtime found" >&2
	exit 1
fi

exec "${node_bin}" /usr/local/bin/webauthn-proxy-host.mjs "$@"
