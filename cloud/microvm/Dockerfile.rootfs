# Base rootfs for Frostfire Multi-Agent Cloud MicroVM (Ubuntu 24.04 LTS)
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV DISPLAY=:1

# 1. Core utilities, X11 headless stack, desktop tools, and recording utilities
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    wget \
    git \
    sudo \
    procps \
    net-tools \
    iproute2 \
    iptables \
    xvfb \
    x11vnc \
    novnc \
    websockify \
    openbox \
    xfwm4 \
    xterm \
    chromium-browser \
    dbus-x11 \
    python3 \
    python3-pip \
    nodejs \
    npm \
    flock \
    ffmpeg \
    xdotool \
    x11-utils \
    xinput \
    sqlite3 \
    && rm -rf /var/lib/apt/lists/*

# 2. Configure unprivileged 'box' user (UID 1000, GID 1000, passwordless sudo)
RUN useradd -m -s /bin/bash -u 1000 box && \
    echo "box ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers.d/box && \
    chmod 0440 /etc/sudoers.d/box

# 3. Create canonical filesystem directories matching Frostfire microVM topology
RUN mkdir -p /workspace \
             /exec-daemon \
             /tmp/sand-novnc-tokens.d \
             /tmp/sand-window-tokens.d \
             /tmp/.X11-unix \
             /home/box/chrome-profile/Default \
             /home/box/chrome-profile-2/Default \
             /home/box/chrome-profile-3/Default \
             /workspace/teach-sessions \
             /etc/opt/chrome/policies/managed && \
    chown -R box:box /workspace \
                     /exec-daemon \
                     /tmp/sand-novnc-tokens.d \
                     /tmp/sand-window-tokens.d \
                     /tmp/.X11-unix \
                     /home/box/chrome-profile* \
                     /workspace/teach-sessions && \
    chmod 1777 /tmp/.X11-unix /tmp/sand-novnc-tokens.d /tmp/sand-window-tokens.d

# 4. Copy supervisor and session management scripts into /usr/local/bin
COPY scripts/start-desktop.sh /usr/local/bin/start-desktop
COPY scripts/sand-window-router.mjs /usr/local/bin/sand-window-router.mjs
COPY scripts/cdp-cookies.mjs /usr/local/bin/cdp-cookies.mjs
COPY scripts/link-chrome-session.sh /usr/local/bin/link-chrome-session
COPY scripts/teach-session-recorder.sh /usr/local/bin/teach-session-recorder

RUN chmod +x /usr/local/bin/start-desktop \
             /usr/local/bin/sand-window-router.mjs \
             /usr/local/bin/cdp-cookies.mjs \
             /usr/local/bin/link-chrome-session \
             /usr/local/bin/teach-session-recorder

# 5. Chrome launch wrapper for display isolation and remote CDP debugging
RUN cat << 'EOF' > /usr/local/bin/box-chrome
#!/usr/bin/env bash
set -euo pipefail

DISPLAY_NUM="${DISPLAY#*:}"
DISPLAY_NUM="${DISPLAY_NUM%%.*}"
CDP_PORT=$((9222 + DISPLAY_NUM))
PROFILE_DIR="/home/box/chrome-profile"
if [ "$DISPLAY_NUM" -gt 1 ]; then
  PROFILE_DIR="/home/box/chrome-profile-${DISPLAY_NUM}"
  /usr/local/bin/link-chrome-session "${PROFILE_DIR}"
fi

exec chromium-browser \
  --remote-debugging-port="${CDP_PORT}" \
  --remote-debugging-address=127.0.0.1 \
  --user-data-dir="${PROFILE_DIR}" \
  --no-first-run \
  --no-default-browser-check \
  --disable-dev-shm-usage \
  --disable-gpu \
  --window-size=1280,800 \
  "$@"
EOF
RUN chmod +x /usr/local/bin/box-chrome

WORKDIR /workspace
USER box

EXPOSE 1337 1338 1339 5901 5902 5903 6080 6081 8790 8791 9223 9224 9225

CMD ["/usr/local/bin/start-desktop"]
